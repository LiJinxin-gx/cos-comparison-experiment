# =============================================================================
# feature_extraction.module_bat
# Multi-level feature extraction: passive boundary + active template +
# local statistics + threshold quantization.
# Tensors are inlined; function results stored via -> pos and reused via dataN.
# Run: python -m cos_comparison batch feature_extraction.module_bat
# =============================================================================

print "=== Feature Extraction Pipeline ==="
print "Input: 5x5 periodic pattern"

# --- Level 1: Passive boundary extraction (stored in data0) ---
print "--- Level 1: Passive boundary (3x3 window) ---"
cos_comparison_passive [[1.0 2.0 1.0 2.0 1.0] [2.0 3.0 2.0 3.0 2.0] [1.0 2.0 1.0 2.0 1.0] [2.0 3.0 2.0 3.0 2.0] [1.0 2.0 1.0 2.0 1.0]] -window_size (3 3) -step (1 1) -d (1 0) -> 0
print data0

# --- Level 2: Active template matching (stored in data1) ---
print "--- Level 2: Active template (center-surround kernel) ---"
cos_comparison_active [[1.0 2.0 1.0 2.0 1.0] [2.0 3.0 2.0 3.0 2.0] [1.0 2.0 1.0 2.0 1.0] [2.0 3.0 2.0 3.0 2.0] [1.0 2.0 1.0 2.0 1.0]] -kernel [[0.0 1.0 0.0] [1.0 2.0 1.0] [0.0 1.0 0.0]] -step (1 1) -w1 1.0 -w2 0.5 -> 1
print data1

# --- Level 3: Local mean (stored in data2) ---
print "--- Level 3: Local mean (3x3) ---"
mean_local [[1.0 2.0 1.0 2.0 1.0] [2.0 3.0 2.0 3.0 2.0] [1.0 2.0 1.0 2.0 1.0] [2.0 3.0 2.0 3.0 2.0] [1.0 2.0 1.0 2.0 1.0]] -local_size (3 3) -step (1 1) -> 2
print data2

# --- Level 4: Local variance (stored in data3) ---
print "--- Level 4: Local variance (3x3) ---"
local_variance [[1.0 2.0 1.0 2.0 1.0] [2.0 3.0 2.0 3.0 2.0] [1.0 2.0 1.0 2.0 1.0] [2.0 3.0 2.0 3.0 2.0] [1.0 2.0 1.0 2.0 1.0]] -local_size (3 3) -step (1 1) -> 3
print data3

# --- Level 5: Quantize passive response ---
print "--- Level 5: Quantize passive (0/1/2) ---"
threshold_map data0 -pairs ((0.0 0.5 0.0) (0.5 0.8 1.0) (0.8 2.0 2.0)) -default_value -1.0 -> 4
print data4

# --- Level 6: Quantize active response ---
print "--- Level 6: Quantize active (0/1/2) ---"
threshold_map data1 -pairs ((0.0 0.3 0.0) (0.3 0.6 1.0) (0.6 2.0 2.0)) -default_value -1.0 -> 5
print data5

# --- Cross-level similarity ---
print "--- Cross-level similarity ---"
cos data0 data2 -> 6
print "passive vs mean:"
print data6

cos data1 data3 -> 7
print "active vs variance:"
print data7

print "=== feature_extraction complete: 6 levels ==="
