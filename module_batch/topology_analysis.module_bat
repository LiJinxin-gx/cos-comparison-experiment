# --- 2. Euler characteristic ---
print "--- Euler Characteristic ---"

# chi = V - E + F (for 2D)
# Triangle: 3V, 3E, 1F -> chi = 1
let triangle ((0 3) (1 3) (2 1))
Euler_characteristic_compute_by_cell data3 -> 4
print "Triangle (3V,3E,1F), expect chi=1:"
print data4

# Square: 4V, 4E, 1F -> chi = 1
let square ((0 4) (1 4) (2 1))
Euler_characteristic_compute_by_cell data5 -> 6
print "Square (4V,4E,1F), expect chi=1:"
print data6

# Torus: 1V, 2E, 1F -> chi = 0
let torus ((0 1) (1 2) (2 1))
Euler_characteristic_compute_by_cell data7 -> 8
print "Torus (1V,2E,1F), expect chi=0:"
print data8

# Two points: 2V -> chi = 2
let two_points ((0 2))
Euler_characteristic_compute_by_cell data9 -> 10
print "Two isolated points, expect chi=2:"
print data10

