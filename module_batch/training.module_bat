# =============================================================================
# training.module_bat
# Training Call Template (translated from templates/training_template.py)
# Edit the training data location below, then run:
#     python -m cos_comparison batch training.module_bat
# The data location is set through the imported input helper
# (import_module input -> input.set_data_dir).
# Data format: txt (one float per line per sample) -> 1D samples; use
# 2D window sizes when the samples are nested (fmt "nested").
# =============================================================================

import_module input

# --- 1. Training data location (EDIT THIS) ---
input.set_data_dir "C:/path/to/training/data" -> 0
print "data dir:"
print data[0]

# --- 2. Backend (priority: ctypes, fallback pure Python) ---
core.set_mode (cos_comparison_c cos_comparison)
core.get_mode -> 1
print "backend mode:"
print data[1]

# --- 3. Load training data (class directory structure) ---
input.load_training_data -fmt "txt" -> 2
print "classes:"
print data[2]

# --- 4. Feature extraction (first class, first sample) ---
input.count data[2] -> 3
print "class count:"
print data[3]

input.sample_at data[2] 0 0 -> 4
print "first sample:"
print data[4]

cos_comparison_passive data[4] -window_size (3) -step (1) -d (1) -> 5
print "[passive] feature:"
print data[5]

mean_local data[4] -local_size (3) -step (1) -> 6
print "[mean_local] feature:"
print data[6]

local_variance data[4] -local_size (3) -step (1) -> 7
print "[local_variance] feature:"
print data[7]

# --- 5. Similarity (self similarity of the first sample) ---
cos data[4] data[4] -> 8
print "[cos] self similarity (expect 1.0):"
print data[8]

print "=== Training template complete ==="
